# CourseCore API base URL. Point this at the backend running locally
# (see the "Backend / API contract" section in CLAUDE.md).
NEXT_PUBLIC_API_URL=https://localhost:7165

# Cloudflare Turnstile site key (public). Leave empty in development —
# the register page skips rendering the widget and submits an empty
# captchaToken, which the local CourseCore backend accepts as long as
# Turnstile:SecretKey is also unconfigured there (see
# Docs/specs/auth/register.md, "Known gap").
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional support channel shown in the landing footer. WhatsApp wins when both
# are set. Digits only for WhatsApp, country code included (e.g. 5511999999999).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
